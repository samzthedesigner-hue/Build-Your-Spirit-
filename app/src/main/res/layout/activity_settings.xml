<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" 
    android:padding="16dp"
    android:background="#0A192F"
    android:layout_width="match_parent" 
    android:layout_height="match_parent">
    
    <Button android:id="@+id/btn_add" 
        android:text="Add Confession" 
        android:backgroundTint="#172A45"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>
        
    <Button android:id="@+id/btn_readonly" 
        android:text="Toggle Read-only" 
        android:backgroundTint="#172A45"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>
        
    <Button android:id="@+id/btn_music" 
        android:text="Music" 
        android:backgroundTint="#172A45"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>
        
    <ScrollView android:layout_width="match_parent" 
        android:layout_height="0dp" 
        android:layout_weight="1"
        android:layout_marginTop="16dp">
        
        <LinearLayout android:id="@+id/confession_list" 
            android:orientation="vertical"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
