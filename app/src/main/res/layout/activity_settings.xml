<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" 
    android:padding="16dp"
    android:background="#0A192F"
    android:layout_width="match_parent" 
    android:layout_height="match_parent">
    
    <Button android:id="@+id/btn_add" 
        android:text="Add Confession" 
        android:backgroundTint="#172A45"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>
        
    <Button android:id="@+id/btn_readonly" 
        android:text="Toggle Read-only" 
        android:backgroundTint="#172A45"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>

    <TextView android:text="Background Music"
        android:textColor="#64FFDA"
        android:textSize="14sp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btn_download_prayer" 
        android:text="🌐 Find Prayer Instrumentals" 
        android:backgroundTint="#172A45"
        android:textColor="#CCD6F6"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btn_download_worship" 
        android:text="🌐 Find Worship Instrumentals" 
        android:backgroundTint="#172A45"
        android:textColor="#CCD6F6"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btn_download_tongues" 
        android:text="🌐 Find Praying in Tongues" 
        android:backgroundTint="#172A45"
        android:textColor="#CCD6F6"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>

    <Button android:id="@+id/btn_pick_music" 
        android:text="🎵 Select Music From Phone" 
        android:backgroundTint="#172A45"
        android:textColor="#64FFDA"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>
        
    <Button android:id="@+id/btn_auto_recent" 
        android:text="⚡ Auto-Load Recently Downloaded" 
        android:backgroundTint="#172A45"
        android:textColor="#64FFDA"
        android:layout_width="match_parent" 
        android:layout_height="wrap_content"/>
        
    <ScrollView android:layout_width="match_parent" 
        android:layout_height="0dp" 
        android:layout_weight="1"
        android:layout_marginTop="16dp">
        
        <LinearLayout android:id="@+id/confession_list" 
            android:orientation="vertical"
            android:layout_width="match_parent" 
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
